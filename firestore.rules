rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'oceantraceproject@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // User saved investigations
      match /savedInvestigations/{investigationId} {
        allow read, write: if isOwner(userId);
      }

      // User saved comparisons
      match /savedComparisons/{comparisonId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Team members (Public read for public profiles, write only by verified admin)
    match /teamMembers/{memberId} {
      allow read: if (resource.data.isPublic == true) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
